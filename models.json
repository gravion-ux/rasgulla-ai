{
  "_comment": "Free-endpoint model routing with multi-provider fallback. Chains use dict entries {provider, model} for multi-endpoint routing.",
  "endpoint": "https://openrouter.ai/api/v1/chat/completions",
  "key_env": ["RASGULLA_API_KEY", "OPENROUTER_API_KEY"],
  "defaults": {
    "requests_per_minute": 20,
    "timeout_seconds": 90,
    "deep_timeout_seconds": 200,
    "cooldown_rate_limit_seconds": 90,
    "cooldown_timeout_seconds": 300,
    "max_attempts_per_request": 4
  },
  "providers": {
    "openrouter": {
      "endpoint": "https://openrouter.ai/api/v1/chat/completions",
      "key_env": ["OPENROUTER_API_KEY", "RASGULLA_API_KEY"],
      "free_suffix": ":free",
      "free_models": ["openrouter/free"]
    },
    "gemini": {
      "endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
      "key_env": ["GEMINI_API_KEY", "GOOGLE_API_KEY"],
      "free_models": ["gemini-3.5-flash-lite", "gemini-3.1-flash-lite", "gemini-flash-lite-latest"]
    },
    "nvidia": {
      "endpoint": "https://integrate.api.nvidia.com/v1/chat/completions",
      "key_env": ["NVIDIA_API_KEY"],
      "free_models": ["nvidia/nemotron-3-ultra-550b-a55b"]
    }
  },
  "tiers": {
    "chat": {
      "label": "Flash",
      "temperature": 0.55,
      "max_tokens": 4000,
      "chain": [
        {"provider": "openrouter", "model": "openrouter/free"},
        {"provider": "gemini", "model": "gemini-3.5-flash-lite"},
        {"provider": "openrouter", "model": "nemotron-3.5-lightning:free"}
      ]
    },
    "code": {
      "label": "Abyss",
      "temperature": 0.2,
      "max_tokens": 4000,
      "chain": [
        {"provider": "openrouter", "model": "openrouter/free"},
        {"provider": "gemini", "model": "gemini-3.5-flash-lite"},
        {"provider": "nvidia", "model": "nvidia/nemotron-3-ultra-550b-a55b"}
      ]
    },
    "reason": {
      "label": "Zenith",
      "temperature": 0.25,
      "max_tokens": 4000,
      "chain": [
        {"provider": "openrouter", "model": "openrouter/free"},
        {"provider": "gemini", "model": "gemini-3.5-flash-lite"},
        {"provider": "nvidia", "model": "nvidia/nemotron-3-ultra-550b-a55b"}
      ]
    },
    "vision": {
      "label": "Super VL",
      "temperature": 0.2,
      "max_tokens": 2500,
      "chain": [
        {"provider": "openrouter", "model": "openrouter/free"},
        {"provider": "gemini", "model": "gemini-3.5-flash-lite"},
        {"provider": "openrouter", "model": "particle-ai/particle-1:free"}
      ]
    },
    "creative": {
      "label": "Muse",
      "temperature": 0.9,
      "max_tokens": 4000,
      "chain": [
        {"provider": "openrouter", "model": "openrouter/free"},
        {"provider": "gemini", "model": "gemini-3.5-flash-lite"},
        {"provider": "nvidia", "model": "nvidia/nemotron-3-ultra-550b-a55b"}
      ]
    },
    "security": {
      "label": "Ultra",
      "temperature": 0.3,
      "max_tokens": 4000,
      "chain": [
        {"provider": "openrouter", "model": "openrouter/free"},
        {"provider": "gemini", "model": "gemini-3.5-flash-lite"},
        {"provider": "nvidia", "model": "nvidia/nemotron-3-ultra-550b-a55b"}
      ]
    }
  },
  "aliases": {
    "openrouter/free": "Auto",
    "nvidia/nemotron-3-ultra-550b-a55b": "Lightning",
